{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile document containing account role and metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase user ID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo URL"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "User role authorization level"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when account profile was created"
        },
        "lastSeenAt": {
          "type": "string",
          "description": "ISO timestamp when user was last seen"
        },
        "activitySummary": {
          "type": "object",
          "description": "Lightweight summary of meaningful user activity counts"
        },
        "notificationPreferences": {
          "type": "object",
          "description": "User notification preferences across event categories"
        }
      },
      "required": ["uid", "role"]
    },
    "Feeling": {
      "title": "Feeling Submission",
      "description": "Unedited personal feeling submitted by user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user submitting the feeling"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000,
          "description": "Content of the feeling"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when feeling was submitted"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when feeling was updated"
        },
        "type": {
          "type": "string",
          "enum": [
            "feeling"
          ],
          "description": "Submission type identifier"
        }
      },
      "required": [
        "userId",
        "content",
        "type"
      ]
    },
    "Letter": {
      "title": "Letter Submission",
      "description": "Personal letter written to recipient",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user writing the letter"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional title of the letter"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "Body content of the letter"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when letter was created"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when letter was updated"
        },
        "type": {
          "type": "string",
          "enum": [
            "letter"
          ],
          "description": "Submission type identifier"
        }
      },
      "required": [
        "userId",
        "content",
        "type"
      ]
    },
    "Activity": {
      "title": "User Activity Event",
      "description": "Meaningful user activity event recorded in Starlit Letters",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user who performed the activity"
        },
        "type": {
          "type": "string",
          "description": "Activity event type identifier"
        },
        "section": {
          "type": "string",
          "description": "Section in which the activity occurred"
        },
        "itemId": {
          "type": "string",
          "description": "Identifier of the item interacted with"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when activity was recorded"
        },
        "metadata": {
          "type": "object",
          "description": "Optional metadata associated with event (excludes private text content)"
        }
      },
      "required": [
        "userId",
        "type",
        "section",
        "itemId"
      ]
    },
    "PhotoBoothMemory": {
      "title": "Photo Booth Memory",
      "description": "User photo memory metadata captured in the Photo Booth",
      "type": "object",
      "properties": {
        "photoId": {
          "type": "string",
          "description": "Unique photo identifier"
        },
        "uid": {
          "type": "string",
          "description": "Firebase user ID who captured and owns the photo"
        },
        "storagePath": {
          "type": "string",
          "description": "Storage path where the compressed WebP photo is stored"
        },
        "downloadUrl": {
          "type": "string",
          "description": "Storage download URL for the photo"
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp when photo was saved"
        },
        "frameId": {
          "type": "string",
          "description": "Selected frame ID"
        },
        "filterId": {
          "type": "string",
          "description": "Selected filter ID"
        },
        "aspectRatio": {
          "type": "string",
          "enum": ["1:1", "4:5", "3:4", "9:16", "16:9"],
          "description": "Aspect ratio of the photo"
        },
        "cameraFacing": {
          "type": "string",
          "enum": ["user", "environment"],
          "description": "Camera facing mode used during capture"
        },
        "width": {
          "type": "number",
          "description": "Width in pixels"
        },
        "height": {
          "type": "number",
          "description": "Height in pixels"
        }
      },
      "required": [
        "photoId",
        "uid",
        "storagePath",
        "frameId",
        "filterId",
        "aspectRatio",
        "cameraFacing"
      ]
    },
    "BtsActivity": {
      "title": "Behind The Scenes Activity Event",
      "description": "Activity event recorded when user interacts with Behind The Scenes content",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the authenticated user who performed the BTS interaction"
        },
        "eventType": {
          "type": "string",
          "enum": [
            "bts_page_open",
            "bts_item_open",
            "bts_video_play",
            "bts_audio_play",
            "bts_random",
            "bts_html_open_external"
          ],
          "description": "BTS interaction event type identifier"
        },
        "itemId": {
          "type": "string",
          "description": "Identifier of the BTS item or view interacted with"
        },
        "itemTitle": {
          "type": "string",
          "description": "Title of the BTS item"
        },
        "itemType": {
          "type": "string",
          "enum": ["image", "video", "audio", "pdf", "html"],
          "description": "Media type of the BTS item"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the event occurred"
        },
        "metadata": {
          "type": "object",
          "description": "Non-sensitive event metadata"
        }
      },
      "required": [
        "userId",
        "eventType",
        "itemId"
      ]
    },
    "Doodle": {
      "title": "User Doodle Drawing",
      "description": "Handmade drawing created by user in What Am I To You or Your Reflections",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique doodle identifier"
        },
        "userId": {
          "type": "string",
          "description": "User identifier who created the doodle"
        },
        "section": {
          "type": "string",
          "enum": ["what-am-i-to-you", "your-reflections"],
          "description": "Section where the doodle was created"
        },
        "title": {
          "type": "string",
          "description": "Optional title for the drawing"
        },
        "strokes": {
          "type": "array",
          "description": "Array of stroke points and styling"
        },
        "thumbnailDataUrl": {
          "type": "string",
          "description": "Transparent preview image representation"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when the doodle was created"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp when the doodle was last updated"
        }
      },
      "required": [
        "id",
        "userId",
        "section"
      ]
    },
    "NotificationToken": {
      "title": "FCM Notification Token",
      "description": "Firebase Cloud Messaging Web Push registration token for device notifications",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique token document identifier"
        },
        "uid": {
          "type": "string",
          "description": "Authenticated Firebase user ID owning the token"
        },
        "token": {
          "type": "string",
          "description": "Full FCM Web Push registration token"
        },
        "platform": {
          "type": "string",
          "description": "Client operating system / device platform"
        },
        "browser": {
          "type": "string",
          "description": "Browser client name and version"
        },
        "userAgent": {
          "type": "string",
          "description": "Browser User-Agent string"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when token was registered"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp when token was refreshed or verified"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether device notifications are currently enabled for this token"
        }
      },
      "required": [
        "uid",
        "token",
        "enabled"
      ]
    },
    "NotificationEvent": {
      "title": "Notification Event",
      "description": "Queued notification event to be processed and delivered to user devices via Cloud Messaging",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Target recipient user ID"
        },
        "type": {
          "type": "string",
          "enum": [
            "LETTER_AVAILABLE",
            "OPEN_WHEN_AVAILABLE",
            "SECRET_UNLOCKED",
            "MOMENT_AVAILABLE",
            "BIRTHDAY",
            "GENERAL"
          ],
          "description": "Event type identifier"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Notification title text"
        },
        "body": {
          "type": "string",
          "maxLength": 1000,
          "description": "Notification body content"
        },
        "data": {
          "type": "object",
          "description": "Optional payload data metadata such as eventKey, action URL, or content IDs"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "processing", "sent", "failed"],
          "description": "Delivery queue status"
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp when event was queued"
        },
        "processedAt": {
          "type": "string",
          "description": "Timestamp when event began processing or null"
        },
        "sentAt": {
          "type": "string",
          "description": "Timestamp when event was delivered or null if pending"
        },
        "successfulTokenCount": {
          "type": "number",
          "description": "Number of devices successfully notified"
        },
        "failedTokenCount": {
          "type": "number",
          "description": "Number of device tokens that failed delivery"
        },
        "failureReason": {
          "type": "string",
          "description": "Failure details if status is failed"
        }
      },
      "required": [
        "userId",
        "type",
        "title",
        "body",
        "status"
      ]
    },
    "NotificationTemplate": {
      "title": "Notification Template",
      "description": "Centralized notification wording and personalization template for event categories",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique template identifier (e.g. tmpl_letter_available)"
        },
        "category": {
          "type": "string",
          "enum": [
            "LETTER_AVAILABLE",
            "OPEN_WHEN_AVAILABLE",
            "SECRET_UNLOCKED",
            "MOMENT_AVAILABLE",
            "BIRTHDAY",
            "GENERAL"
          ],
          "description": "Target event category"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Template title containing optional placeholders"
        },
        "body": {
          "type": "string",
          "maxLength": 1000,
          "description": "Template body containing optional placeholders"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this template is enabled"
        },
        "version": {
          "type": "number",
          "description": "Incrementing template version"
        },
        "variables": {
          "type": "array",
          "description": "List of supported variable names"
        },
        "actionRoute": {
          "type": "string",
          "description": "Target deep link route for notifications generated by this template"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "updatedBy": {
          "type": "string",
          "description": "User UID of admin who last updated the template"
        }
      },
      "required": [
        "id",
        "category",
        "title",
        "body",
        "enabled",
        "version"
      ]
    }
  },
  "firestore": {
    "/notificationTemplates/{templateId}": {
      "schema": "NotificationTemplate",
      "description": "Root collection of admin-managed notification personalization templates"
    },
    "/notificationEvents/{eventId}": {
      "schema": "NotificationEvent",
      "description": "Root collection of notification events awaiting delivery"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document containing account role and timestamp information"
    },
    "/users/{userId}/activity/{activityId}": {
      "schema": "Activity",
      "description": "Collection of activity events recorded by a specific user"
    },
    "/users/{userId}/btsActivity/{activityId}": {
      "schema": "BtsActivity",
      "description": "Collection of Behind The Scenes activity records for a specific user"
    },
    "/users/{userId}/doodles/{doodleId}": {
      "schema": "Doodle",
      "description": "Collection of hand-drawn doodles created by a specific user"
    },
    "/users/{userId}/feelings/{feelingId}": {
      "schema": "Feeling",
      "description": "Collection of feelings written by a specific user"
    },
    "/users/{userId}/letters/{letterId}": {
      "schema": "Letter",
      "description": "Collection of letters written by a specific user"
    },
    "/users/{userId}/notificationTokens/{tokenId}": {
      "schema": "NotificationToken",
      "description": "Private collection of FCM Web Push device notification tokens for a specific user"
    },
    "/users/{userId}/photoBooth/{photoId}": {
      "schema": "PhotoBoothMemory",
      "description": "Private collection of photo memories captured by a specific user"
    }
  }
}
